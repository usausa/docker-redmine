# このファイルを .env にコピーして、✏️ の値を入れる。
#   cp .env.example .env
# .env は Git 管理外（.gitignore）。実際の値をコミットしないこと。
# 値に $ や # や空白を含めるときは、値全体を '...' で囲む。

# ---- Redmine の版 ----
# 変えたら docker compose build --pull でビルドし直す
REDMINE_VERSION=7.0.2

# ---- ✏️ PostgreSQL のパスワード ----
#   openssl rand -base64 24
DB_PASSWORD=CHANGE_ME

# ---- ✏️ セッションの署名鍵（一度決めたら変えない）----
#   openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME

# ---- ✏️ 初期設定で使う値（setup/initial_setup.rb が読む）----
# 利用者が開く URL のホスト名とポート（例: redmine.example.com:8080）。通知メールのリンクに使う
SETUP_HOST_NAME=
# http または https
SETUP_PROTOCOL=http
# 通知メールの送信元アドレス
SETUP_MAIL_FROM=
# admin のメールアドレス
SETUP_ADMIN_EMAIL=

# ---- ✏️ メール送信（SMTP）----
# SMTP_ADDRESS が空のあいだは、メールを送らない
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
# 認証が要らない SMTP サーバーなら SMTP_USER を空にする
SMTP_USER=
SMTP_PASSWORD=
